#!/usr/bin/env python3
"""Build, test, archive, install, and pair the Mission Control iOS app."""
from __future__ import annotations

import argparse
import os
import shutil
import subprocess
import urllib.parse
import urllib.request
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
IOS_DIR = ROOT / "ios"
PROJECT_YML = IOS_DIR / "project.yml"
XCODEPROJ = IOS_DIR / "AgyControl.xcodeproj"
BUILD_DIR = IOS_DIR / "build"
ARCHIVE_PATH = BUILD_DIR / "AgyControl.xcarchive"
TOKEN_PATH = Path("~/.local/state/agy-control/token").expanduser()


def load_xcconfig_vars() -> dict[str, str]:
    values: dict[str, str] = {}
    for cfg in (
        IOS_DIR / "Config" / "Local.xcconfig",
        Path("~/.config/agy-control/ios-private.xcconfig").expanduser(),
    ):
        if not cfg.is_file():
            continue
        for raw_line in cfg.read_text(encoding="utf-8").splitlines():
            line = raw_line.strip()
            if not line or line.startswith("//") or line.startswith("#") or "=" not in line:
                continue
            key, val = [part.strip() for part in line.split("=", 1)]
            val = val.replace("/$()/", "//")
            values[key] = val
    return values


LOCAL_CFG = load_xcconfig_vars()
DEVICE_ID = os.environ.get("AGY_IOS_DEVICE_ID") or LOCAL_CFG.get("AGY_IOS_DEVICE_ID", "")
BUNDLE_ID = os.environ.get("AGY_IOS_BUNDLE_ID") or LOCAL_CFG.get("AGY_BUNDLE_ID", "org.example.agycontrol")
HUB_URL = (os.environ.get("AGY_CONTROL_URL") or LOCAL_CFG.get("AGY_DEFAULT_SERVER", "http://127.0.0.1:8696")).rstrip("/")
FALLBACK_URL = (os.environ.get("AGY_FALLBACK_SERVER") or LOCAL_CFG.get("AGY_FALLBACK_SERVER", "")).rstrip("/")


def run(cmd: list[str], *, check: bool = True) -> subprocess.CompletedProcess[str]:
    print("+", " ".join(cmd), flush=True)
    return subprocess.run(cmd, text=True, check=check)


def wrap_heavy(cmd: list[str]) -> list[str]:
    heavy = shutil.which("heavy-slot")
    return [heavy, "--", *cmd] if heavy else cmd


def cmd_generate(_args: argparse.Namespace) -> int:
    run(["xcodegen", "generate", "--spec", str(PROJECT_YML), "--project", str(IOS_DIR)])
    return 0


def cmd_test(args: argparse.Namespace) -> int:
    cmd_generate(args)
    run(wrap_heavy([
        "xcodebuild",
        "-project", str(XCODEPROJ),
        "-scheme", "AgyControl",
        "-destination", args.destination,
        "test",
    ]))
    return 0


def archive_device() -> Path:
    BUILD_DIR.mkdir(parents=True, exist_ok=True)
    if ARCHIVE_PATH.exists():
        shutil.rmtree(ARCHIVE_PATH)
    base_cmd = wrap_heavy([
        "xcodebuild",
        "-project", str(XCODEPROJ),
        "-scheme", "AgyControl",
        "-configuration", "Release",
        "-destination", "generic/platform=iOS",
        "-archivePath", str(ARCHIVE_PATH),
    ])
    res = run(base_cmd + ["-allowProvisioningUpdates", "archive"], check=False)
    if res.returncode != 0:
        print("Retrying archive with cached signing profile...", flush=True)
        if ARCHIVE_PATH.exists():
            shutil.rmtree(ARCHIVE_PATH)
        run(base_cmd + ["CODE_SIGN_ENTITLEMENTS=", "archive"], check=True)
    app_dir = ARCHIVE_PATH / "Products" / "Applications" / "AgyControl.app"
    if not app_dir.is_dir():
        raise RuntimeError(f"Expected {app_dir} after archive")
    return app_dir


def cmd_build_device(args: argparse.Namespace) -> int:
    cmd_generate(args)
    app_dir = archive_device()
    print(f"Built signed device app: {app_dir}")
    return 0


def resolve_device_id(explicit: str | None) -> str:
    device = (explicit or DEVICE_ID).strip()
    if not device:
        raise RuntimeError(
            "Missing device ID: pass --device UDID, set AGY_IOS_DEVICE_ID, or add AGY_IOS_DEVICE_ID to Local.xcconfig"
        )
    return device


def cmd_install_device(args: argparse.Namespace) -> int:
    device = resolve_device_id(args.device)
    cmd_generate(args)
    app_dir = archive_device()
    run(["xcrun", "devicectl", "device", "install", "app", "--device", device, str(app_dir)])
    return 0


def cmd_pair_device(args: argparse.Namespace) -> int:
    device = resolve_device_id(args.device)
    if not TOKEN_PATH.is_file():
        raise RuntimeError(f"Missing token file at {TOKEN_PATH}")
    tok = TOKEN_PATH.read_text(encoding="utf-8").strip()
    if len(tok) < 16:
        raise RuntimeError("Token is missing or too short")
    hub = (args.url or HUB_URL).rstrip("/")
    fallback = (getattr(args, "fallback", None) or FALLBACK_URL).rstrip("/")
    pair_url = f"agycontrol://pair?url={urllib.parse.quote(hub, safe='')}"
    if fallback and fallback != hub:
        pair_url += f"&fallback={urllib.parse.quote(fallback, safe='')}"
    pair_url += f"&token={urllib.parse.quote(tok, safe='')}"
    res = subprocess.run(
        [
            "xcrun", "devicectl", "device", "process", "launch",
            "--device", device,
            "--payload-url", pair_url,
            BUNDLE_ID,
        ],
        capture_output=True,
        text=True,
    )
    if res.returncode != 0:
        msg = (res.stderr or res.stdout or "").strip()
        print(f"Device launch did not complete (exit {res.returncode}): {msg}")
        return res.returncode
    print(f"Launched {BUNDLE_ID} on device {device} with pairing link.")
    return 0


def cmd_status(_args: argparse.Namespace) -> int:
    try:
        with urllib.request.urlopen(f"{HUB_URL}/healthz", timeout=5) as resp:
            print("API healthz:", resp.status, resp.read().decode().strip())
    except Exception as exc:
        print("API healthz failed:", exc)
        return 1
    return 0


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(description="Manage Mission Control iOS build, tests, and device deployment")
    sub = ap.add_subparsers(dest="cmd", required=True)

    sub.add_parser("generate", help="Run xcodegen to generate AgyControl.xcodeproj")
    p_test = sub.add_parser("test", help="Run iOS Simulator unit tests")
    p_test.add_argument("--destination", default="platform=iOS Simulator,name=iPhone 16")
    sub.add_parser("build-device", help="Archive signed Release device build")
    p_inst = sub.add_parser("install-device", help="Build and install onto paired iPhone")
    p_inst.add_argument("--device", default=None)
    p_pair = sub.add_parser("pair-device", help="Launch installed app with pairing link")
    p_pair.add_argument("--device", default=None)
    p_pair.add_argument("--url", default=None)
    sub.add_parser("status", help="Check Mac companion API health")

    args = ap.parse_args(argv)
    return {
        "generate": cmd_generate,
        "test": cmd_test,
        "build-device": cmd_build_device,
        "install-device": cmd_install_device,
        "pair-device": cmd_pair_device,
        "status": cmd_status,
    }[args.cmd](args)


if __name__ == "__main__":
    raise SystemExit(main())
